# Discord Webhooks (役割ベース 5 チャンネル)
#   alert       … 即応 (KEV/0day, 日本標的+APT 等の即応事象)
#   brief       … 朝読 (RSS 由来 high/medium 通常記事)
#   watch       … 観察 (recap/tutorial/opinion/press/research, 信頼性低事象)
#   ops         … 運用通知 (パイプライン死活、エラー通知)
#   japan_watch … 日本関連の弱信号 (省略時は alert にフォールバック)
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_BRIEF=
DISCORD_WEBHOOK_WATCH=
DISCORD_WEBHOOK_OPS=
DISCORD_WEBHOOK_JAPAN_WATCH=

# Phase 5T-K: digest pipeline 用 (https://discord.com/channels/{guild}/{ch}/{msg})
# Discord server (guild) の ID。Discord 設定 → 開発者モード ON → サーバ名右クリック → ID をコピー。
# 未設定なら digest は元記事 URL で表示 (fallback)。
DISCORD_GUILD_ID=

# Email (Grokタスクメール受信用、Phase 2以降)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Ollama
# モデルタグは公式リリース確定後に置き換える (CLAUDE.md / README.md 参照)
# Docker 運用時は host.docker.internal (compose が ${OLLAMA_BASE_URL:-…} で補間、
# UI「設定 → モデル」タブの ollama 行から編集可)。ホスト直実行時は localhost。
OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM モデルの実割当は能力ティア方式 (src/tools/model_tiers.py) で管理し、.env には持たない。
# runtime の SSoT は DB (config_store "model_tiers")。bootstrap 既定はコードの
# BUILTIN_MODEL_TIERS (reasoning=gemma4:31b / fast=gemma4:26b / embedding=snowflake-arctic-embed2)。
# 初回起動で DB に seed され、以後は Web UI「設定 → モデル」タブで編集する (版履歴付き)。
# 中華系モデルは 3 層 whitelist で除外 (CLAUDE.md §4)。詳細: docs/model_tier_architecture.md

# 外部 LLM (任意、2026-07-18 §4 改訂): Anthropic API キー。
# 空 = 外部 LLM 無効 (ローカル Ollama のみ、従来挙動)。設定すると UI「モデル」タブの
# 選択肢に anthropic:claude-* が現れ、ティアに明示割当した処理だけが外部 API に送られる。
# UI「設定 → モデル」タブからも設定/削除できる (.env はファイルマウントで request ごとに
# 再読込されるため即時反映・再起動不要)。
# 中華系 denylist はプロバイダ横断で維持。埋込ティアは外部不可 (ローカルのみ)。
ANTHROPIC_API_KEY=

# Phase Diamond verify-mobile: Cloudflare quick tunnel の初回 deploy 時の default。
# 1 = 起動と同時に自動 tunnel + Discord ops ch に URL 通知、0 = 起動時 OFF。
# 初回 deploy 後は UI Schedule page の toggle / flag file の状態が優先される。
MOBILE_TUNNEL_DEFAULT_ENABLED=1

# 恒久安定 URL (named tunnel) は **UI から管理**する (2026-07-30 C2)。
# 設定 → モバイル公開カードの「固定ドメイン (named tunnel)」で token / hostname を保存すると
# data/ ファイル (0600) に書かれ、URL が再起動・再デプロイで変わらなくなる。
# ⚠️ CLOUDFLARE_TUNNEL_TOKEN を **.env に書かないこと**: compose は tunnel コンテナへ env 注入
# しなくなり (cloudflared の env ダンプ経由の log 露出を断つため)、.env に置いても不発なうえ、
# 秘密が .env に残留する。取得・設定手順は docs/mobile-access.md。

# 通知再設計 (Discord=警告 / Web=状況認識): web-only disposition は env でなく
# channel レジストリの push 属性で制御する (Web UI /app/flow の「Discord 配信」トグル)。
# push=False の tier (watch/brief/japan_watch 等) は Discord に投稿せず DB 保存のみ。
# alert と日次ダイジェスト (朝刊/夕刊) は常に push。設定は DB(config_store)・版履歴あり。

# 公開 instance の Tier1 認証 (2026-08-01、任意)。Cloudflare Access を kuebiko.example/auth/* に
# 被せ、認証済み利用者だけに運用系ページの閲覧とジョブ即時実行を解放する。
# 2 つとも設定したときだけ有効 (未設定なら従来どおり匿名閲覧のみ)。取得手順は
# docs/mobile-access.md。AUD tag は秘密ではないが .env で管理する (DB には置かない)。
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# その他
LOG_LEVEL=INFO
TIMEZONE=Asia/Tokyo

# --- Database (PostgreSQL) ---
# docker compose の postgres service 用パスワード。未設定時は開発用既定値
# (cti_local_dev) が使われる。本番運用では必ず独自の値を設定すること。
POSTGRES_PASSWORD=
# DATABASE_URL は通常 docker-compose.yml が組み立てるため設定不要
# (ホスト直実行で SQLite fallback を避けたい場合のみ明示)。
# DATABASE_URL=

# --- 調整用 (任意、通常は既定のままで可) ---
# READ_ONLY=1            # 閲覧専用インスタンス化 (docker-compose の readonly service が設定)
# FULL_INSTANCE_URL=     # readonly からジョブ即時実行を proxy する full instance の URL
# PIPELINE_TIME_BUDGET_SECONDS=   # 収集 run 全体の soft deadline (既定はコード側)
# PER_ARTICLE_TIMEOUT_SECONDS=    # 記事 1 件の処理上限 (同上)
# CLAUDE_CODE_OAUTH_TOKEN=        # (任意) claude-code-bridge ホスト補助サービス用
#
# LLM 呼出の同時実行数。既定は現行挙動 (記事=逐次 / triage=5)。
# 実測 (gemma4:26b、4 件 x 3 往復 ABABAB、OLLAMA_NUM_PARALLEL=4):
#   decode 主体 (記事処理) 1.85x 改善 / prefill 主体 (triage) 1.00x 変わらない
# **2 点セットで効く**。片方だけだと効かない:
#   1. ホスト: launchctl setenv OLLAMA_NUM_PARALLEL 4
#      (+ launchctl kickstart -k gui/$(id -u)/com.ollama.ollama で反映。
#       既定 1 スロットは同時要求を直列化するため、これを上げないと 2 が効かない)
#   2. ARTICLE_CONCURRENCY=4
# TRIAGE_CONCURRENCY は速度に効かないので既定 5 のままでよい。
# ARTICLE_CONCURRENCY=1           # 記事処理の同時実行数 (1=逐次、上限 8)
# TRIAGE_CONCURRENCY=5            # triage の同時実行数 (上限 8)

# ログアウト後の戻り先 (公開ニュースサイト)。未設定なら /app/ へ戻る
PUBLIC_SITE_URL=

# ---- 運用フラグ (2026-09-17、いずれも rollback 用。既定は未設定 = ON) ----
# detect ML (docs/research/llm_training/SYNTHESIS.md §47): 新規追跡の候補を ML (config/models/
# detect_model.json) の確率上位 K 件に絞ってから LLM が claim を選ぶ。0 = 絞らない (従来どおり)。
# DETECT_ML_PREFILTER=15
# ML の閾値上位を detect_ml_shadow テーブルに記録 (切替判断の差分比較用)。0 = 記録しない。
# DETECT_ML_SHADOW=1
# 台帳の増分再評価を毎時保守チェーンの段として回す (開設なし、cap 件/時)。0 = 朝夕の run だけ。
# LEDGER_REASSESS_HOURLY=1
# LEDGER_REASSESS_HOURLY_CAP=6
# 状況総括 render の SIR ロールアップを番号参照にする (§48、prompt 29% 短縮)。0 = 旧形 (判定文再掲)。
# SYNTHESIS_SIR_REF=1
# 地政学の文脈情勢の再評価 予約枠 (2026-09-19)。サイバー = 追跡の主力 / 地政学 = 判断を支える文脈で
# 要る鮮度が違う。予約しないと証拠量の多い地政学が優先度順で枠を取り、単一事象の更新が繰り越された
# (実測: revision の 45% を 26 件が消費)。**除外ではなく配分** — サイバーは物理的な地政学に影響され、
# また与えるため。0 で無効 (従来どおり優先度順に競合)。
# SYNTHESIS_GEO_RESERVE=2

# 当局の摘発・無力化・起訴・押収・逮捕の発表を alert から watch に下げる (語の条件のみ)。0 = 下げない。
# ALERT_EXCLUDE_LAW_ENFORCEMENT=0
# 直近 72 時間の alert と同じ事象 (事象の群化 ML の確率が高い) の重複 alert を watch に下げる。0 = 下げない。
# ALERT_DEDUP_EVENT=0
# 重複 alert の ML の判断を alert_dedup_shadow に記録だけする (配信は変えない)。0 = 記録しない。
# ALERT_DEDUP_SHADOW=1
# LLM の TTP は本文で裏付けられるものだけ残す。shadow = 記録のみ / off = 無効。
# TTP_EVIDENCE_GATE=on
# LLM の TTP の件数の歯止め (実在しない ID・引用の使い回し・上限 12 件)。on = 適用 / shadow = 記録のみ (既定) / off = 無効。
# TTP_LIMIT=shadow
# 記事本文 (body / body_ja / linked_context) の日次 purge の日数。0 = 消さない (既定、2026-10-29)。90 = 従来の 90 日 purge。
# BODY_PURGE_DAYS=0
# 薄い Grok 投稿の要約が本文に無い数字・日付を足していないかの関門。on = 作り直し、なお違反なら LLM 要約を捨てる / shadow = 記録のみ (既定) / off = 無効。
# GROK_SUMMARY_GROUNDING=shadow
# Grok の投稿が貼った外部リンク (最大 2 件) の本文を取りに行く。shadow = 取って保存するが要約には使わない (既定) / on = 要約の材料と裏付けの照合範囲に足す / off = 取得しない。
# GROK_LINK_FETCH=shadow
# (任意) GROK_LINK_RELEVANCE_GATE=0 で「主題に触れない参照先を材料に入れない」関門を止める (既定 on)
# (任意) GROK_LINK_MAX_LINKS=2 / GROK_LINK_MAX_CHARS=3000 / GROK_LINK_TIMEOUT_S=25 / GROK_LINK_BUDGET_S=120
# 配信判断の時点で深刻度の軸を inline で取り、routing v2 の配信先を影として記録する。0 = inline の LLM 呼び出しを止める。
# ROUTING_V2_INLINE_AXES=1
# 翻訳の固有名詞・識別子・数字の化けの検出関門。on = どれかの化けで訳を保存せず原文を出す (修復はしない) / ident = 識別子 (CVE 等) の化けだけで保存しない (語・数字は log のみ) / shadow = 検出を log だけ / off = 無効。
# TRANSLATE_FIDELITY_GATE=shadow
# 翻訳キューの先頭詰まり対策 (P0-24)。1 = 失敗が3回続いた記事を 24h・72h・7 日空けるまで毎時のバックログ翻訳で選ばない (6 回目以降は選ばない) / 0 = 従来どおり。
# TRANSLATE_QUEUE_BACKOFF=1
# Grok の描画されなかったレポートの取り直しの上限 (P0-25)。同じメールが N 回続けて描かれなければ取り直しをやめて 1 回だけ通知し、取得窓から外れる前に 1 回警告する / 0 = 従来どおり毎回取り直し・毎回警報。
# GROK_RETRY_CAP=3

# 公開サイトのログインリンク先 (運用画面のオリジン、例 https://ops.kuebiko.example)。
# scripts/build_public_site.sh が必須で読む (未設定ならビルドを止める)
OPERATOR_ORIGIN=

# 標準 (公開サイト、/news) とアドバンスド (旧「写し」、/app) は 2026-10-05 以降
# 同じドメイン・同じ Cloudflare Pages プロジェクト (CLOUDFLARE_PAGES_PROJECT) から
# 配信する。切替導線 (SiteSwitch) は同一オリジンの相対パスなので、ビルド時の
# オリジン注入 (旧 MIRROR_ORIGIN / VITE_MIRROR_ORIGIN / VITE_PUBLIC_ORIGIN) は不要になった。
#
# PUBLIC_SITE_ORIGIN は今も使う — ただし用途は旧サブドメイン (アドバンスドが
# 単独で居たドメイン、CLOUDFLARE_MIRROR_PAGES_PROJECT) から新しい場所
# (<PUBLIC_SITE_ORIGIN>/app) へ 301 リダイレクトするためだけ
# (scripts/deploy_mirror_redirect.sh が読む)。
PUBLIC_SITE_ORIGIN=

# --- 挙動の旗 (compose の既定値の一覧、2026-10-28 に同期) ---
# docker-compose.yml の kuebiko の environment が `${旗:-既定値}` で読む。.env に書いたときだけ既定値を上書きする。
# 意味・測定の根拠・戻し方は CLAUDE.md §7 の表が SSoT (ここには複製しない)。
# ACH_EVIDENCE_CAP=0
# ACTOR_CANDIDATE_HARVEST=0
# ASSIGN_EMBED_GATE=shadow
# ASSIGN_ML=0
# ASSIGN_PROBE_FEATURE=1
# AXES_FROM_BODY=0
# CLAUDE_BRIDGE_AUTOUPDATE=1
# CYBER_POLICY_RESCUE=off
# DEDUP_CLUSTER_JUDGE=0
# DETECT_DECOMPOSE=shadow
# EVENTNEWS_FOCUS_RECORD=1
# EVENTNEWS_MASKED_VICTIM_GATE=1
# EVENTNEWS_MERGE_BULLETIN_BRIDGE_GATE=1
# EVENTNEWS_MERGE_CVE_GATE=1
# EVENTNEWS_MERGE_FOCUS_GATE=on
# EVENTNEWS_MERGE_HUB_GATE=0
# EVENTNEWS_MERGE_MAX_GAP_DAYS=60
# EVENTNEWS_MERGE_REAL_KIND=0
# EVENTNEWS_MERGE_REPORT_PERIOD_GATE=1
# EVENTNEWS_ORG_IDENTITY=shadow
# EVENTNEWS_ORG_NORM=1
# EVENTNEWS_PAIR_ML=0
# EVENTNEWS_PAIR_SHADOW=0
# EVENT_DATE_MONTH_FORM=0
# GEOPOLITICAL_HIGH_CAP=on
# INGEST_RULE_V2=1
# INVOLVED_COUNTRY_GATE=1
# LEDGER_CLAIM_SUBJECT_GATE=on
# PIR_FOCUS_CLAIM_GATE=1
# PIR_FOCUS_FIDELITY_GATE=1
# PIR_FOCUS_PROMPT_V6=
# PIR_JUDGE_REASON_V2=0
# PIR_LLM_JUDGE=1
# PIR_SIGNAL_FIRST=1
# READ_ONLY_ALLOW_REMOTE_WRITE=0
# ROUNDUP_IMPORTANCE_CAP=title
# ROUTING_RULES_ENGINE=1
# STANDING_SITUATIONS=0
# SUMMARIZER_RUBRIC_V8R4=0
# SYNTHESIS_COT_NOTES=0
# SYNTHESIS_GROUNDED=0
# SYNTHESIS_STATE=0
# THIN_BODY_GATE=1
# THIN_BODY_PROBE=1
# TRIAGE_FLAT=1
# VICTIM_COUNTRY_FILL=shadow
# VICTIM_COUNTRY_GATE_KEYWORD=1
