# Discord Webhooks (役割ベース 5 チャンネル)
#   alert       … 即応 (KEV/0day, 日本標的+APT 等の即応事象)
#   brief       … 朝読 (RSS 由来 high/medium 通常記事)
#   watch       … 観察 (recap/tutorial/opinion/press/research, 信頼性低事象)
#   ops         … 運用通知 (パイプライン死活、エラー通知)
#   japan_watch … 日本関連の弱信号 (省略時は alert にフォールバック)
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_BRIEF=
DISCORD_WEBHOOK_WATCH=
DISCORD_WEBHOOK_OPS=
DISCORD_WEBHOOK_JAPAN_WATCH=

# Phase 5T-K: digest pipeline 用 (https://discord.com/channels/{guild}/{ch}/{msg})
# Discord server (guild) の ID。Discord 設定 → 開発者モード ON → サーバ名右クリック → ID をコピー。
# 未設定なら digest は元記事 URL で表示 (fallback)。
DISCORD_GUILD_ID=

# Email (Grokタスクメール受信用、Phase 2以降)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Ollama
# モデルタグは公式リリース確定後に置き換える (CLAUDE.md / README.md 参照)
# Docker 運用時は host.docker.internal (compose が ${OLLAMA_BASE_URL:-…} で補間、
# UI「設定 → モデル」タブの ollama 行から編集可)。ホスト直実行時は localhost。
OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM モデルの実割当は能力ティア方式 (src/tools/model_tiers.py) で管理し、.env には持たない。
# runtime の SSoT は DB (config_store "model_tiers")。bootstrap 既定はコードの
# BUILTIN_MODEL_TIERS (reasoning=gemma4:31b / fast=gemma4:26b / embedding=snowflake-arctic-embed2)。
# 初回起動で DB に seed され、以後は Web UI「設定 → モデル」タブで編集する (版履歴付き)。
# 中華系モデルは 3 層 whitelist で除外 (CLAUDE.md §4)。詳細: docs/model_tier_architecture.md

# 外部 LLM (任意、2026-07-18 §4 改訂): Anthropic API キー。
# 空 = 外部 LLM 無効 (ローカル Ollama のみ、従来挙動)。設定すると UI「モデル」タブの
# 選択肢に anthropic:claude-* が現れ、ティアに明示割当した処理だけが外部 API に送られる。
# UI「設定 → モデル」タブからも設定/削除できる (.env はファイルマウントで request ごとに
# 再読込されるため即時反映・再起動不要)。
# 中華系 denylist はプロバイダ横断で維持。埋込ティアは外部不可 (ローカルのみ)。
ANTHROPIC_API_KEY=

# Phase Diamond verify-mobile: Cloudflare quick tunnel の初回 deploy 時の default。
# 1 = 起動と同時に自動 tunnel + Discord ops ch に URL 通知、0 = 起動時 OFF。
# 初回 deploy 後は UI Schedule page の toggle / flag file の状態が優先される。
MOBILE_TUNNEL_DEFAULT_ENABLED=1

# 恒久安定 URL (named tunnel) は **UI から管理**する (2026-07-30 C2)。
# 設定 → モバイル公開カードの「固定ドメイン (named tunnel)」で token / hostname を保存すると
# data/ ファイル (0600) に書かれ、URL が再起動・再デプロイで変わらなくなる。
# ⚠️ CLOUDFLARE_TUNNEL_TOKEN を **.env に書かないこと**: compose は tunnel コンテナへ env 注入
# しなくなり (cloudflared の env ダンプ経由の log 露出を断つため)、.env に置いても不発なうえ、
# 秘密が .env に残留する。取得・設定手順は docs/mobile-access.md。

# 通知再設計 (Discord=警告 / Web=状況認識): web-only disposition は env でなく
# channel レジストリの push 属性で制御する (Web UI /app/flow の「Discord 配信」トグル)。
# push=False の tier (watch/brief/japan_watch 等) は Discord に投稿せず DB 保存のみ。
# alert と日次ダイジェスト (朝刊/夕刊) は常に push。設定は DB(config_store)・版履歴あり。

# 公開 instance の Tier1 認証 (2026-08-01、任意)。Cloudflare Access を kuebiko.example/auth/* に
# 被せ、認証済み利用者だけに運用系ページの閲覧とジョブ即時実行を解放する。
# 2 つとも設定したときだけ有効 (未設定なら従来どおり匿名閲覧のみ)。取得手順は
# docs/mobile-access.md。AUD tag は秘密ではないが .env で管理する (DB には置かない)。
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# その他
LOG_LEVEL=INFO
TIMEZONE=Asia/Tokyo

# --- Database (PostgreSQL) ---
# docker compose の postgres service 用パスワード。未設定時は開発用既定値
# (cti_local_dev) が使われる。本番運用では必ず独自の値を設定すること。
POSTGRES_PASSWORD=
# DATABASE_URL は通常 docker-compose.yml が組み立てるため設定不要
# (ホスト直実行で SQLite fallback を避けたい場合のみ明示)。
# DATABASE_URL=

# --- 調整用 (任意、通常は既定のままで可) ---
# READ_ONLY=1            # 閲覧専用インスタンス化 (docker-compose の readonly service が設定)
# FULL_INSTANCE_URL=     # readonly からジョブ即時実行を proxy する full instance の URL
# PIPELINE_TIME_BUDGET_SECONDS=   # 収集 run 全体の soft deadline (既定はコード側)
# PER_ARTICLE_TIMEOUT_SECONDS=    # 記事 1 件の処理上限 (同上)
# CLAUDE_CODE_OAUTH_TOKEN=        # (任意) claude-code-bridge ホスト補助サービス用
#
# LLM 呼出の同時実行数。既定は現行挙動 (記事=逐次 / triage=5)。
# 実測 (gemma4:26b、4 件 x 3 往復 ABABAB、OLLAMA_NUM_PARALLEL=4):
#   decode 主体 (記事処理) 1.85x 改善 / prefill 主体 (triage) 1.00x 変わらない
# **2 点セットで効く**。片方だけだと効かない:
#   1. ホスト: launchctl setenv OLLAMA_NUM_PARALLEL 4
#      (+ launchctl kickstart -k gui/$(id -u)/com.ollama.ollama で反映。
#       既定 1 スロットは同時要求を直列化するため、これを上げないと 2 が効かない)
#   2. ARTICLE_CONCURRENCY=4
# TRIAGE_CONCURRENCY は速度に効かないので既定 5 のままでよい。
# ARTICLE_CONCURRENCY=1           # 記事処理の同時実行数 (1=逐次、上限 8)
# TRIAGE_CONCURRENCY=5            # triage の同時実行数 (上限 8)
