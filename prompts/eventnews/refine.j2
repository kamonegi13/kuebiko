    {"text": "報じられている内容 1 件 (1 文)", "source_index": 1, "paragraph": 1, "section": "what"},
    {"text": "影響の広さを述べる文", "source_index": 2, "paragraph": 2, "section": "scope"},
    {"text": "悪用の仕組みを述べる文", "source_index": 1, "paragraph": 3, "section": "how"},
    {"text": "取られた措置を述べる文", "source_index": 3, "paragraph": 4, "section": "response"}
  ],
